# =============================================================
# Campus Recruitment Portal - Environment Configuration
# =============================================================

# Flask Application Secret
SECRET_KEY=campus_recruitment_portal_super_secret_key_2026

# -------------------------------------------------------------
# GOOGLE OAUTH 2.0 / OPENID CONNECT SETTINGS
# Create credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: https://<your-domain>/auth/google/callback
# Or locally: http://127.0.0.1:5000/auth/google/callback
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Optional: explicitly override redirect URI (useful behind reverse proxies)
# GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# -------------------------------------------------------------
# REAL SMS OTP PROVIDER SETTINGS
# Choose provider: twilio_verify | twilio_sms | fast2sms
# -------------------------------------------------------------
SMS_PROVIDER=twilio_verify

# Option A: Twilio Verify Service (Recommended for OTP)
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Option B: Twilio Programmable SMS (Direct SMS delivery)
TWILIO_PHONE_NUMBER=+1234567890

# Option C: Fast2SMS (Indian SMS Gateway)
# Get API key at https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key
